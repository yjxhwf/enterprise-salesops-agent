APP_NAME=Enterprise SalesOps Agent
APP_ENV=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./backend/storage/salesops.db
# JSON array of explicit origins; no wildcard.
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# Optional separate credential; blank reuses LLM_API_KEY only for the same provider.
EMBEDDING_API_KEY=
APPROVAL_TTL_MINUTES=30
